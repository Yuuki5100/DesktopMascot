<Window x:Class="DesktopMascot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopMascot"
        Width="220"
        Height="176"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="SpeechBubblePanel"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
            <Border Background="White"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,6"
                    MaxWidth="200">
                <TextBlock x:Name="SpeechText"
                           Foreground="#222222"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
            <Polygon Points="0,0 12,0 6,7"
                     Width="12"
                     Height="7"
                     HorizontalAlignment="Center"
                     Fill="White"
                     Stroke="#444444"
                     StrokeThickness="1" />
        </StackPanel>

        <Image x:Name="CharacterImage"
               Grid.Row="1"
               Stretch="Uniform"
               Width="128"
               HorizontalAlignment="Center"
               VerticalAlignment="Stretch"
               SnapsToDevicePixels="True"
               IsHitTestVisible="True"
               PreviewMouseLeftButtonDown="CharacterImage_MouseLeftButtonDown"
               PreviewMouseMove="CharacterImage_MouseMove"
               PreviewMouseLeftButtonUp="CharacterImage_MouseLeftButtonUp">
            <Image.ContextMenu>
                <ContextMenu x:Name="MascotMenu"
                             Opened="MascotMenu_Opened"
                             Closed="MascotMenu_Closed">
                    <MenuItem Header="Edge起動" Click="LaunchEdge_Click" />
                    <MenuItem Header="VS Code起動" Click="LaunchVsCode_Click" />
                    <MenuItem Header="WezTerm起動" Click="LaunchWezTerm_Click" />
                    <Separator />
                    <MenuItem Header="VS Codeキャッシュ削除" Click="ClearVsCodeCache_Click" />
                    <MenuItem Header="Teamsキャッシュ削除" Click="ClearTeamsCache_Click" />
                    <Separator />
                    <MenuItem Header="設定">
                        <MenuItem Header="アニメーション">
                            <MenuItem x:Name="IdleAnimationMenuItem"
                                      Header="待機"
                                      IsCheckable="True"
                                      Click="IdleAnimationMenuItem_Click" />
                            <MenuItem x:Name="WalkAnimationMenuItem"
                                      Header="歩く"
                                      IsCheckable="True"
                                      IsChecked="True"
                                      Click="WalkAnimationMenuItem_Click" />
                        </MenuItem>
                        <MenuItem Header="キャラ変更">
                            <MenuItem x:Name="PompompurinCharacterMenuItem"
                                      Header="ポムポムプリン"
                                      IsCheckable="True"
                                      IsChecked="True"
                                      Click="PompompurinCharacterMenuItem_Click" />
                            <MenuItem x:Name="AiHayatoCharacterMenuItem"
                                      Header="AIハヤト"
                                      IsCheckable="True"
                                      Click="AiHayatoCharacterMenuItem_Click" />
                        </MenuItem>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="DesktopMascot停止" Click="ExitMascot_Click" />
                </ContextMenu>
            </Image.ContextMenu>
        </Image>
    </Grid>
</Window>
